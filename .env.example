# Set this to the final HTTPS origin in production before building.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=cyberi

# A single administrator is created on the first sign-in or recovery request.
# After first creation, changing this password does not overwrite the database password.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Site Administrator
ADMIN_INITIAL_PASSWORD=

# Demo articles are visible without a database. Leave this false for a live database.
SHOW_DEMO_BLOGS=false

# Set only if a trusted proxy overwrites this header with one verified client IP.
TRUSTED_CLIENT_IP_HEADER=

# Email OTP and contact enquiry delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Cyber-I Publishing <no-reply@example.com>
CONTACT_TO=

